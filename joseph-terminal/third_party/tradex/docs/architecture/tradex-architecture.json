  "cards": [
    {
      "dot": "cyan",
      "title": "Install and update",
      "items": [
        "One command downloads the newest TradeX from GitHub and sets up Python, packages and chart sources",
        "MetaTrader 5: use your own account, or TradeX opens a free demo for you",
        "Running it again updates the app files and keeps data/, .env and private/",
        "Setup switches on only the exchanges that answer from your network"
      ]
    },
    {
      "dot": "emerald",
      "title": "Charts",
      "items": [
        "Server and WebSocket listen on 127.0.0.1 only",
        "Built-in feeds plus plugin feeds in hub/feeds/, one file per exchange",
        "MetaTrader 5 locally or on your VPS is optional, set in .env"
      ]
    },
    {
      "dot": "rose",
      "title": "Private by design",
      "items": [
        ".env and private/ are git-ignored and skipped by the installer",
        "private/ adds your own routes and page scripts only when the folder exists",
        "Without private/ you get plain TradeX"
      ]
    }
