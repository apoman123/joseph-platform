# Leave every value empty to run in DEMO mode (synthetic `mock` venue only).
# Setting the market engine URLs switches market data to LIVE backend mode;
# failures then show STALE/UNAVAILABLE states, never synthetic candles.
NEXT_PUBLIC_MARKET_API_URL=
NEXT_PUBLIC_MARKET_WS_URL=
NEXT_PUBLIC_EXECUTION_API_URL=
NEXT_PUBLIC_EXECUTION_WS_URL=
# Local development only. Production must use a server-side session (BFF);
# never put real credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_DEV_TOKEN=
