{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false,
    "incremental": true,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    ".next-e2e/types/**/*.ts",
    ".next/e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/fullstack/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
