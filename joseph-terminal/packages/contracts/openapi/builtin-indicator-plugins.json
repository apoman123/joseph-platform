    {
      "plugin_id": "anchored_vwap",
      "indicator_version": "2.0.0",
      "schema_version": 2,
      "display_name": "VWAP",
      "description": "Volume-weighted average price from a session, week, month or a chosen bar, with up to three standard-deviation bands.",
      "timeframes": [
        "1s",
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "4h",
        "6h",
        "12h",
        "1d",
        "1w",
