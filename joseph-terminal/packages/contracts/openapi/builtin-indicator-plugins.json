    {
      "plugin_id": "sma",
      "indicator_version": "1.0.0",
      "schema_version": 2,
      "display_name": "SMA",
      "description": "Simple moving average: the mean of the source price over the last length bars.",
      "timeframes": [
        "1s",
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "4h",
        "6h",
        "12h",
        "1d",
        "1w",
        "1M"
      ],
      "warmup_bars": 20,
      "required_streams": [
        "candles:chart"
      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": {
            "description": "Number of bars.",
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 5000
          },
          "source": {
            "description": "Price the study is computed from.",
            "type": "string",
            "enum": [
              "close",
              "open",
              "high",
              "low",
              "hl2",
              "hlc3",
              "ohlc4"
            ],
            "default": "close"
          },
          "tick_size": {
            "description": "Symbol tick size. 0 = filled from the instrument, else inferred from the first bar's price precision.",
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "default": "0",
            "minimum": "0"
          }
        }
      },
      "output_kinds": [],
      "output_events": [],
      "output_values": [
        {
          "key": "sma",
          "type": "decimal",
          "unit": "price",
          "description": "Simple moving average."
        }
      ],
      "display": {
        "layer": true,
        "default_visible": false,
        "z_index": 40,
        "show_events": true,
