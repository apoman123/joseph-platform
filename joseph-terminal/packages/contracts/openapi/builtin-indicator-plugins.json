      ],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "description": "Reset period (session or UTC day, week, month) or a fixed anchor bar (time).",
            "type": "string",
            "enum": [
              "session",
              "week",
              "month",
              "time"
            ],
            "default": "session"
          },
          "anchor_ms": {
            "description": "Anchor time (UTC ms) when anchor is time.",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 4102444800000
          },
          "source": {
            "description": "Price the study is computed from.",
            "type": "string",
            "enum": [
              "close",
              "hl2",
              "hlc3",
              "ohlc4"
            ],
            "default": "hlc3"
          },
          "band_1": {
            "description": "Band 1 width in standard deviations (0 hides it).",
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "default": "1",
            "minimum": "0",
            "maximum": "10"
          },
          "band_2": {
            "description": "Band 2 width in standard deviations (0 hides it).",
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "default": "0",
            "minimum": "0",
            "maximum": "10"
          },
          "band_3": {
            "description": "Band 3 width in standard deviations (0 hides it).",
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "default": "0",
            "minimum": "0",
            "maximum": "10"
          },
          "tick_size": {
            "description": "Symbol tick size. 0 = filled from the instrument, else inferred from the first bar's price precision.",
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "default": "0",
            "minimum": "0"
          }
        }
      },
      "output_kinds": [],
      "output_events": [],
      "output_values": [
        {
          "key": "vwap",
          "type": "decimal",
          "unit": "price",
          "description": "Volume-weighted average price since the anchor."
        },
        {
          "key": "stdev",
          "type": "decimal",
          "unit": "price",
          "description": "Volume-weighted standard deviation of the source."
        },
        {
          "key": "upper_1",
          "type": "decimal",
          "unit": "price",
          "description": "Upper 1 band (null when its multiplier is 0)."
        },
        {
          "key": "lower_1",
          "type": "decimal",
          "unit": "price",
          "description": "Lower 1 band (null when its multiplier is 0)."
        },
        {
