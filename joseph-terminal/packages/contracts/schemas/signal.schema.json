{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.joseph.local/v1/signal.schema.json",
  "title": "JosephSignal",
  "description": "Notifications of Python strategy activations (ENTRY_CONFIRMED, POSITION_EXITED) and alert jobs (CUSTOM_ALERT). A recorded signal is never rewritten.",
  "$defs": {
    "Severity": {
      "title": "Severity",
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ENTRY",
        "CRITICAL"
      ]
    },
    "Signal": {
      "title": "Signal",
      "description": "One notification of a Python strategy or alert on one exact venue instrument and closed bar. Mode is ALERT_ONLY for alerts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "dedupe_key",
        "tenant_id",
        "strategy_id",
        "strategy_version_id",
        "source_hash",
        "instrument_id",
        "direction",
        "timeframe",
        "kind",
        "severity",
        "mode",
        "bar_start_ms",
        "bar_close_ms",
        "evaluated_at_ms",
        "data_source",
        "entry_price",
        "stop_price",
        "target_price",
        "rr",
        "message",
        "condition"
      ],
      "properties": {
        "signal_id": {
          "type": "string",
          "description": "Deterministic id derived from dedupe_key."
        },
        "dedupe_key": {
          "type": "string",
          "description": "Unique per tenant: strategy signals key tenant, activation, source hash, instrument, bar, kind and direction; alerts key the job, script version, condition and bar."
        },
        "tenant_id": {
          "type": "string"
        },
        "strategy_id": {
          "type": "string",
          "description": "Script id of the strategy or alert."
        },
        "strategy_version_id": {
          "type": "string",
          "description": "Immutable script version; execution deployments bind it."
        },
        "source_hash": {
          "type": "string",
          "description": "Hash of the script source that produced the signal."
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT",
            "NONE"
          ],
          "type": "string",
          "description": "NONE denotes a directionless Python alert."
        },
        "timeframe": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "kind": {
          "$ref": "#/$defs/SignalKind"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "mode": {
          "$ref": "common.schema.json#/$defs/ExecutionMode"
        },
        "bar_start_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "bar_close_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "evaluated_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "data_source": {
          "$ref": "common.schema.json#/$defs/FeedState"
        },
        "entry_price": {
          "description": "Planned entry (close of the signal bar) of ENTRY_CONFIRMED; null otherwise.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_price": {
          "description": "Stop the strategy declared with the entry, if any.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_price": {
          "description": "Target the strategy declared with the entry, if any.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "rr": {
          "description": "Reward/risk of entry, stop and target, when all three are set.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "description": "Human-readable summary."
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name of the alert condition that matched (CUSTOM_ALERT); null for strategy signals."
        }
      }
    },
    "SignalList": {
      "title": "SignalList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals"
      ],
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signal"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "QuietHours": {
      "title": "QuietHours",
      "description": "Local-time window in which deliveries are held back, except bypass severities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "tz"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "tz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone, e.g. Asia/Taipei."
        },
        "bypass_severities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Severity"
          }
        }
      }
    },
    "AlertSubscription": {
      "title": "AlertSubscription",
      "description": "Where and when a tenant receives signal notifications. Channel credentials stay on the server. Browser registrations are write-only and omitted from responses.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "channel",
        "target",
        "kinds",
        "min_severity",
        "strategy_ids",
        "enabled"
      ],
      "properties": {
        "subscription_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "TELEGRAM",
            "LINE",
            "EMAIL",
            "WEBHOOK",
            "WHATSAPP",
            "WEB_PUSH"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Telegram chat id, WhatsApp E.164 phone number, Web Push device identifier, LINE user id, e-mail address or HTTPS webhook URL."
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalKind"
          },
          "description": "Empty means every kind."
        },
        "min_severity": {
          "$ref": "#/$defs/Severity"
        },
        "strategy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty means every strategy."
        },
        "enabled": {
          "type": "boolean"
        },
        "quiet_hours": {
          "oneOf": [
            {
              "$ref": "#/$defs/QuietHours"
            },
            {
              "type": "null"
            }
          ]
        },
        "web_push": {
          "type": "object",
          "writeOnly": true,
          "description": "Private browser PushSubscription input. Never returned. Required for initial WEB_PUSH registration.",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "keys"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "maxLength": 2048,
              "description": "HTTPS endpoint on a supported browser push service."
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "p256dh",
                "auth"
              ],
              "properties": {
                "p256dh": {
                  "type": "string",
                  "description": "Base64url uncompressed P-256 public encryption key."
                },
                "auth": {
                  "type": "string",
                  "description": "Base64url 16-byte authentication secret; write only."
                }
              }
            }
          }
        }
      }
    },
    "AlertSubscriptionList": {
      "title": "AlertSubscriptionList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptions",
        "configured_channels"
      ],
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlertSubscription"
          }
        },
        "configured_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UI",
              "TELEGRAM",
              "LINE",
              "EMAIL",
              "WEBHOOK",
              "EXECUTION",
              "WHATSAPP",
              "WEB_PUSH"
            ]
          },
          "description": "Channels the server has credentials for; others dead-letter with a clear reason."
        },
        "web_push_public_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Public VAPID application server key, or null when push is not configured."
        }
      }
    },
    "AlertDelivery": {
      "title": "AlertDelivery",
      "type": "object",
      "additionalProperties": false,
      "description": "Tenant delivery progress. Delivered means provider acceptance, not receipt or read confirmation.",
      "required": [
        "delivery_id",
        "channel",
        "status",
        "attempts",
        "last_error"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "description": "Opaque durable outbox identifier."
        },
        "channel": {
          "type": "string",
          "description": "Notification channel."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "DELIVERED",
            "DEAD"
          ],
          "description": "Pending retry, provider accepted, or permanently failed."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Completed delivery attempts."
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Redacted last failure, if any."
        }
      }
    },
    "SignalKind": {
      "title": "SignalKind",
      "description": "ENTRY_CONFIRMED and POSITION_EXITED come from strategy activations, CUSTOM_ALERT from alert jobs.",
      "type": "string",
      "enum": [
        "ENTRY_CONFIRMED",
        "POSITION_EXITED",
        "CUSTOM_ALERT"
      ]
    }
  }
}
