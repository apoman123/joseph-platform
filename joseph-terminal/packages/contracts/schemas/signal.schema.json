{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.joseph.local/v1/signal.schema.json",
  "title": "JosephSignal",
  "description": "Strategy evaluation outputs. A fired signal is never rewritten; corrections produce a new revision with an audit trail.",
  "$defs": {
    "TriState": {
      "title": "TriState",
      "type": "string",
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "ReasonNode": {
      "title": "ReasonNode",
      "description": "Explanation trace for one evaluated rule node, for both true and false predicates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_path",
        "op",
        "result",
        "detail",
        "children"
      ],
      "properties": {
        "node_path": {
          "type": "string",
          "description": "JSON pointer of the node inside `when`."
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/TriState"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasonNode"
          }
        }
      }
    },
    "SetupState": {
      "title": "SetupState",
      "type": "string",
      "enum": [
        "WAITING",
        "AOI_TOUCHED",
        "CONFIRMING",
        "READY",
        "FIRED",
        "EXPIRED",
        "INVALIDATED",
        "CANCELLED",
        "BLOCKED"
      ]
    },
    "Severity": {
      "title": "Severity",
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ENTRY",
        "CRITICAL"
      ]
    },
    "RiskEvaluation": {
      "title": "RiskEvaluation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Signal": {
      "title": "Signal",
      "description": "One lifecycle notification of a strategy setup on one exact venue instrument.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "dedupe_key",
        "tenant_id",
        "strategy_id",
        "strategy_version_id",
        "instrument_id",
        "direction",
        "timeframe",
        "kind",
        "setup_state",
        "severity",
        "bar_start_ms",
        "bar_close_ms",
        "evaluated_at_ms",
        "inputs_snapshot_hash",
        "rule_version",
        "evaluator_version",
        "indicator_versions",
        "reason_tree",
        "aoi_ids",
        "risk_evaluation",
        "mode",
        "data_source",
        "revision"
      ],
      "properties": {
        "signal_id": {
          "type": "string"
        },
        "dedupe_key": {
          "type": "string",
          "description": "tenant + strategy_version + account scope + instrument + direction + setup id + kind."
        },
        "tenant_id": {
          "type": "string"
        },
        "strategy_id": {
          "type": "string"
        },
        "strategy_version_id": {
          "type": "string"
        },
        "setup_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "direction": {
          "$ref": "common.schema.json#/$defs/Direction"
        },
        "timeframe": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "kind": {
          "$ref": "strategy.schema.json#/$defs/SignalKind"
        },
        "setup_state": {
          "$ref": "#/$defs/SetupState"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "bar_start_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "bar_close_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "evaluated_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "inputs_snapshot_hash": {
          "type": "string"
        },
        "rule_version": {
          "type": "string",
          "description": "definition_hash of the evaluated StrategyVersion."
        },
        "evaluator_version": {
          "type": "string"
        },
        "indicator_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reason_tree": {
          "$ref": "#/$defs/ReasonNode"
        },
        "aoi_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "group_ids": {
          "description": "Zone groups (AOI `group_id`s) bound by true `IN_ZONE` conditions.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bar_base_volume": {
          "description": "Base volume of the evaluated (signal) bar. Not comparable across instruments; rank by bar_quote_volume.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "bar_quote_volume": {
          "description": "Quote-currency turnover of the evaluated bar as published by the venue; null when the venue publishes none (never estimated).",
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_price": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_price": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_price": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "rr": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_evaluation": {
          "$ref": "#/$defs/RiskEvaluation"
        },
        "mode": {
          "$ref": "common.schema.json#/$defs/ExecutionMode"
        },
        "data_source": {
          "$ref": "common.schema.json#/$defs/FeedState"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "SignalList": {
      "title": "SignalList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals"
      ],
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signal"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "QuietHours": {
      "title": "QuietHours",
      "description": "Local-time window in which deliveries are held back, except bypass severities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "tz"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "tz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone, e.g. Asia/Taipei."
        },
        "bypass_severities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Severity"
          }
        }
      }
    },
    "AlertSubscription": {
      "title": "AlertSubscription",
      "description": "Where and when a tenant receives signal notifications. Secrets (bot tokens) are server configuration, never part of a subscription.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "channel",
        "target",
        "kinds",
        "min_severity",
        "strategy_ids",
        "enabled"
      ],
      "properties": {
        "subscription_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "TELEGRAM",
            "LINE",
            "EMAIL",
            "WEBHOOK",
            "WHATSAPP",
            "WEB_PUSH"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Telegram chat id, LINE user id, e-mail address or https webhook URL."
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "strategy.schema.json#/$defs/SignalKind"
          },
          "description": "Empty means every kind."
        },
        "min_severity": {
          "$ref": "#/$defs/Severity"
        },
        "strategy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty means every strategy."
        },
        "enabled": {
          "type": "boolean"
        },
        "quiet_hours": {
          "oneOf": [
            {
              "$ref": "#/$defs/QuietHours"
            },
            {
              "type": "null"
            }
          ]
        },
        "web_push": {
          "type": "object",
          "writeOnly": true,
          "description": "Private browser PushSubscription input. Never returned. Required for initial WEB_PUSH registration.",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "keys"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "maxLength": 2048,
              "description": "HTTPS endpoint on a supported browser push service."
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "p256dh",
                "auth"
              ],
              "properties": {
                "p256dh": {
                  "type": "string",
                  "description": "Base64url uncompressed P-256 public encryption key."
                },
                "auth": {
                  "type": "string",
                  "description": "Base64url 16-byte authentication secret; write only."
                }
              }
            }
          }
        }
      }
    },
    "AlertSubscriptionList": {
      "title": "AlertSubscriptionList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptions",
        "configured_channels"
      ],
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlertSubscription"
          }
        },
        "configured_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UI",
              "TELEGRAM",
              "LINE",
              "EMAIL",
              "WEBHOOK",
              "EXECUTION",
              "WHATSAPP",
              "WEB_PUSH"
            ]
          },
          "description": "Channels the server has credentials for; others dead-letter with a clear reason."
        },
        "web_push_public_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Public VAPID application server key, or null when push is not configured."
        }
      }
    },
    "AlertDelivery": {
      "title": "AlertDelivery",
      "type": "object",
      "additionalProperties": false,
      "description": "Tenant delivery progress. Delivered means provider acceptance, not receipt or read confirmation.",
      "required": [
        "delivery_id",
        "channel",
        "status",
        "attempts",
        "last_error"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "description": "Opaque durable outbox identifier."
        },
        "channel": {
          "type": "string",
          "description": "Notification channel."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "DELIVERED",
            "DEAD"
          ],
          "description": "Pending retry, provider accepted, or permanently failed."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Completed delivery attempts."
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Redacted last failure, if any."
        }
      }
    }
  }
}
