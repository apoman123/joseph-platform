{
  "$defs": {
    "AlertJob": {
      "additionalProperties": false,
      "description": "Persistent Python alert evaluation state and visible diagnostics.\n\nAttributes:\n    job_id: Opaque tenant-owned alert identifier.\n    created_at_ms: Creation time in UTC epoch milliseconds.\n    last_processed_ms: Latest successfully evaluated bar close/checkpoint.\n    last_error: Visible missing-data, provider or user-code failure, if any.\n    last_checked_ms: Last evaluation attempt in UTC epoch milliseconds.\n    emitted: Number of distinct conditions recorded for this job.",
      "properties": {
        "created_at_ms": {
          "title": "Created At Ms",
          "type": "integer"
        },
        "emitted": {
          "default": 0,
          "title": "Emitted",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "history_bars": {
          "default": 500,
          "maximum": 2000,
          "minimum": 2,
          "title": "History Bars",
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "instrument_id": {
          "pattern": "^(bybit|okx|coinbase|kraken|deriv|binance|hyperliquid|lighter|bitget|mexc|twse|tpex|nasdaq|nyse|cboe|treasury|mock):(perp|spot|future|stock|etf|rate):[A-Za-z0-9._/-]{1,64}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "last_checked_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Checked Ms"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "last_processed_ms": {
          "title": "Last Processed Ms",
          "type": "integer"
        },
        "script_id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Script Id",
          "type": "string"
        },
        "subscription_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Subscription Ids",
          "type": "array"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "script_id",
        "version",
        "instrument_id",
        "tf",
        "job_id",
        "created_at_ms",
        "last_processed_ms"
      ],
      "title": "AlertJob",
      "type": "object"
    },
    "AlertJobInput": {
      "additionalProperties": false,
      "description": "Explicitly enables a pinned Python condition on future closed bars.\n\nAttributes:\n    script_id: Owned alert, indicator or strategy script publishing\n        conditions.\n    version: Positive immutable version, pinned rather than following edits.\n    instrument_id: Canonical instrument whose new closed bars are evaluated.\n    tf: Source resolution, one second through one calendar month.\n    inputs: JSON values overriding the pinned version's defaults.\n    subscription_ids: Explicit owned notification destinations; UI is\n        implicit.\n    enabled: Whether evaluation and external notification routing are\n        active.\n    history_bars: Context depth, two through two thousand closed bars.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "history_bars": {
          "default": 500,
          "maximum": 2000,
          "minimum": 2,
          "title": "History Bars",
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "instrument_id": {
          "pattern": "^(bybit|okx|coinbase|kraken|deriv|binance|hyperliquid|lighter|bitget|mexc|twse|tpex|nasdaq|nyse|cboe|treasury|mock):(perp|spot|future|stock|etf|rate):[A-Za-z0-9._/-]{1,64}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "script_id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Script Id",
          "type": "string"
        },
        "subscription_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Subscription Ids",
          "type": "array"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "script_id",
        "version",
        "instrument_id",
        "tf"
      ],
      "title": "AlertJobInput",
      "type": "object"
    },
    "CompanyMetadata": {
      "additionalProperties": false,
      "description": "Explicit optional metadata for feeds without company fundamentals.\n\nAttributes:\n    instrument_id: Canonical stock or ETF identifier.\n    sector: Optional user-provided industry/sector label, maximum 120 chars.\n    market_cap: Optional positive market capitalization in its quote\n        currency,\n        encoded as a decimal string, never inferred from price or volume.\n    as_of_ms: User-declared observation time in UTC epoch milliseconds.",
      "properties": {
        "as_of_ms": {
          "minimum": 0,
          "title": "As Of Ms",
          "type": "integer"
        },
        "instrument_id": {
          "maxLength": 180,
          "title": "Instrument Id",
          "type": "string"
        },
        "market_cap": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Cap"
        },
        "sector": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        }
      },
      "required": [
        "instrument_id",
        "as_of_ms"
      ],
      "title": "CompanyMetadata",
      "type": "object"
    },
    "CompanyMetadataBatch": {
      "additionalProperties": false,
      "description": "An explicit batch of user-owned heatmap fundamentals.\n\nAttributes:\n    records: At most five thousand canonical, dated company records.",
      "properties": {
        "records": {
          "items": {
            "$ref": "#/$defs/CompanyMetadata"
          },
          "maxItems": 5000,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "records"
      ],
      "title": "CompanyMetadataBatch",
      "type": "object"
    },
    "HeatmapSnapshot": {
      "description": "Real stock heatmap data and explicit market/coverage limits.\n\nAttributes:\n    tiles: Selected stocks, including unavailable/neutral tiles.\n    universe_count: Actual eligible stocks before the requested result\n        limit.\n    quote_count: Number with a returned source quote.\n    generated_at_ms: Response generation time, UTC epoch milliseconds.\n    region: US or Taiwan universe; quote currencies are never mixed by size.\n    currency: USD or TWD quote currency of the selected stock region.\n    available_metrics: Metrics actually present in at least one selected\n        tile.\n    missing_metadata: Whether sector or market-cap information is\n        incomplete.\n    source_errors: Provider metadata failures limiting the selected\n        universe.",
      "properties": {
        "available_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Available Metrics",
          "type": "array"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "generated_at_ms": {
          "title": "Generated At Ms",
          "type": "integer"
        },
        "missing_metadata": {
          "title": "Missing Metadata",
          "type": "boolean"
        },
        "quote_count": {
          "title": "Quote Count",
          "type": "integer"
        },
        "region": {
          "enum": [
            "us",
            "taiwan"
          ],
          "title": "Region",
          "type": "string"
        },
        "source_errors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Errors",
          "type": "object"
        },
        "tiles": {
          "items": {
            "$ref": "#/$defs/HeatmapTile"
          },
          "title": "Tiles",
          "type": "array"
        },
        "universe_count": {
          "title": "Universe Count",
          "type": "integer"
        }
      },
      "required": [
        "tiles",
        "universe_count",
        "quote_count",
        "generated_at_ms",
        "region",
        "currency",
        "available_metrics",
        "missing_metadata"
      ],
      "title": "HeatmapSnapshot",
      "type": "object"
    },
    "HeatmapTile": {
      "description": "One stock tile whose missing metrics remain unavailable.\n\nAttributes:\n    instrument_id: Exact venue-scoped stock or ETF identifier.\n    symbol: Provider display symbol.\n    name: Provider company/security name when available.\n    exchange: Actual listing exchange or canonical venue.\n    last: Latest source price as a decimal string, or None.\n    change_pct: Source daily price change in percent, or None.\n    volume: Source daily base volume as a decimal string, or None.\n    turnover: Source daily quote turnover, or None.\n    market_cap: Explicit optional company metadata, never a volume proxy.\n    sector: Explicit optional company sector, otherwise unclassified.\n    metadata_as_of_ms: Date of user-supplied fundamentals, or None.\n    feed_state: Actual quote provenance state; unavailable without a quote.\n    source: Actual provider label; never promoted to a broader market feed.\n    as_of_ms: Actual quote observation time, or None without a quote.\n    error: Provider/missing-data explanation, or None for an available\n        quote.",
      "properties": {
        "as_of_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of Ms"
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Change Pct"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "exchange": {
          "title": "Exchange",
          "type": "string"
        },
        "feed_state": {
          "title": "Feed State",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "last": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last"
        },
        "market_cap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Market Cap"
        },
        "metadata_as_of_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metadata As Of Ms"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sector"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "turnover": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turnover"
        },
        "volume": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume"
        }
      },
      "required": [
        "instrument_id",
        "symbol",
        "name",
        "exchange",
        "last",
        "change_pct",
        "volume",
        "turnover",
        "market_cap",
        "sector",
        "metadata_as_of_ms",
        "feed_state",
        "source",
        "as_of_ms",
        "error"
      ],
      "title": "HeatmapTile",
      "type": "object"
    },
    "JsonValue": {},
    "LibraryRef": {
      "additionalProperties": false,
      "description": "Pins one reusable library to an immutable tenant-owned version.\n\nAttributes:\n    script_id: Tenant-local library slug.\n    version: Positive immutable version number; never resolves latest.",
      "properties": {
        "script_id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Script Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "script_id",
        "version"
      ],
      "title": "LibraryRef",
      "type": "object"
    },
    "PlotPoint": {
      "additionalProperties": false,
      "description": "One script-produced scalar at a closed bar.\n\nAttributes:\n    time_ms: Bar start in UTC epoch milliseconds.\n    value: Finite numeric output, or None during warm-up.\n    color: Optional literal per-bar hex color for conditional plot coloring.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "time_ms": {
          "title": "Time Ms",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "time_ms",
        "value"
      ],
      "title": "PlotPoint",
      "type": "object"
    },
    "PlotSeries": {
      "additionalProperties": false,
      "description": "Named output series displayed by the terminal.\n\nAttributes:\n    name: Public series name, one to sixty-four characters.\n    points: At most two thousand chronological closed-bar values.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PlotPoint"
          },
          "maxItems": 2000,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "name",
        "points"
      ],
      "title": "PlotSeries",
      "type": "object"
    },
    "ScanInput": {
      "additionalProperties": false,
      "description": "Selects a real market universe for an isolated Python filter job.\n\nAttributes:\n    version: Optional immutable filter version; defaults to the latest.\n    venue: Exchange/market venue to scan, or all enabled venues.\n    market_type: Optional instrument market category, such as stock or perp.\n    query: Optional symbol/name search within that market.\n    max_symbols: Explicit maximum instruments, one through ten thousand.\n    history_bars: Closed bars per instrument; zero uses snapshots only.\n    tf: Resolution used when historical bars are requested.\n    inputs: JSON values overriding the pinned filter's defaults.",
      "properties": {
        "history_bars": {
          "default": 0,
          "maximum": 500,
          "minimum": 0,
          "title": "History Bars",
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "market_type": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/MarketType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_symbols": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Symbols",
          "type": "integer"
        },
        "query": {
          "default": "",
          "maxLength": 120,
          "title": "Query",
          "type": "string"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe",
          "default": "1d"
        },
        "venue": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Venue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ScanInput",
      "type": "object"
    },
    "ScanJob": {
      "additionalProperties": false,
      "description": "Progress and reproducible results for an asynchronous market scan.\n\nAttributes:\n    job_id: Opaque tenant-owned scan identifier.\n    script_id: Filter script slug.\n    version: Immutable filter version pinned at submission.\n    status: Pending, running, complete, failed or cancelled job state.\n    created_at_ms: Submission time, UTC epoch milliseconds.\n    total: Number of eligible instruments selected by the explicit scan\n        bound.\n    scanned: Instruments evaluated or reported unavailable so far.\n    matches: Matching instrument records with real source snapshots.\n    errors: Per-instrument missing-data or user-code errors.\n    error: Job-level error, otherwise None.\n    source_hash: Immutable source/dependency configuration hash.\n    universe_count: Total eligible market instruments before max_symbols.",
      "properties": {
        "created_at_ms": {
          "title": "Created At Ms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "errors": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Errors",
          "type": "array"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "matches": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Matches",
          "type": "array"
        },
        "scanned": {
          "default": 0,
          "title": "Scanned",
          "type": "integer"
        },
        "script_id": {
          "title": "Script Id",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "total": {
          "default": 0,
          "title": "Total",
          "type": "integer"
        },
        "universe_count": {
          "default": 0,
          "title": "Universe Count",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "job_id",
        "script_id",
        "version",
        "status",
        "created_at_ms",
        "source_hash"
      ],
      "title": "ScanJob",
      "type": "object"
    },
    "ScriptAlertEvent": {
      "additionalProperties": false,
      "description": "One user-authored alert condition matched on a source bar.\n\nAttributes:\n    name: Stable condition name used for per-bar delivery deduplication.\n    message: Plain-text message, at most five hundred characters.\n    time_ms: Source bar start, UTC epoch milliseconds.\n    severity: Notification priority used by delivery filters and quiet\n        hours.",
      "properties": {
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "severity": {
          "default": "INFO",
          "enum": [
            "INFO",
            "WARNING",
            "ENTRY",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "time_ms": {
          "title": "Time Ms",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "message",
        "time_ms"
      ],
      "title": "ScriptAlertEvent",
      "type": "object"
    },
    "ScriptInput": {
      "additionalProperties": false,
      "description": "Creates an immutable script version with explicit type and dependencies.\n\nAttributes:\n    script_id: Stable tenant-local slug; must match the path on updates.\n    kind: One of the five script roles; immutable after creation.\n    name: Display title, one to one hundred twenty characters.\n    source: UTF-8 Python source, at most sixty-four KiB.\n    overlay: Whether indicator/strategy plots share the main price pane.\n    defaults: Default JSON input values overridden by an individual run.\n    libraries: Python import aliases mapped to pinned library versions.\n    expected_version: Optimistic lock for edits; required for a new version.\n    requests: Up to four declared cross-symbol/timeframe source aliases.",
      "properties": {
        "defaults": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Defaults",
          "type": "object"
        },
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "kind": {
          "enum": [
            "indicator",
            "strategy",
            "library",
            "filter",
            "alert"
          ],
          "title": "Kind",
          "type": "string"
        },
        "libraries": {
          "additionalProperties": {
            "$ref": "#/$defs/LibraryRef"
          },
          "title": "Libraries",
          "type": "object"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overlay": {
          "default": true,
          "title": "Overlay",
          "type": "boolean"
        },
        "requests": {
          "additionalProperties": {
            "$ref": "#/$defs/SeriesRequest"
          },
          "maxProperties": 4,
          "title": "Requests",
          "type": "object"
        },
        "script_id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Script Id",
          "type": "string"
        },
        "source": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "script_id",
        "kind",
        "name",
        "source"
      ],
      "title": "ScriptInput",
      "type": "object"
    },
    "ScriptResult": {
      "additionalProperties": false,
      "description": "Reproducible plots and optional simulated strategy performance.\n\nAttributes:\n    script_id: Tenant-owned script slug.\n    version: Immutable script version evaluated.\n    kind: Indicator, strategy, filter or alert; libraries are import-only.\n    source_hash: Content hash including default inputs and dependency pins.\n    instrument_id: Canonical source instrument identifier.\n    tf: Source bar resolution.\n    bars_count: Number of source bars evaluated, including provisional bars\n        only when explicitly requested for an indicator.\n    feed_state: Source provenance; DEMO data remains explicitly marked.\n    data_source: Upstream provider provenance label.\n    complete: Whether the requested history has no closed-bar gaps.\n    overlay: Whether plots share the main price pane.\n    plots: At most sixty-four scalar output series.\n    fills: Simulated next-bar-open fills; empty for indicators.\n    equity_curve: Marked simulated quote equity; empty for indicators.\n    metrics: Finite numeric simulation statistics, including fees and\n        unfilled final-bar intents; no performance is fabricated.\n    matched: Boolean decision for a filter, otherwise None.\n    alerts: Previewed alert events; delivery requires an enabled alert job.\n    visuals: Bounded declarative drawings, fills, coloring and tables.\n    bar_closes: Confirmed source bar starts mapped to actual evaluated\n        closes;\n        alert checkpoints never consult a later, different market window.\n    plot_styles: Per-series input/style settings used by the renderer.\n    bar_visuals: Per-bar colors, symbols and custom OHLC series, separately\n        bounded from persistent drawing objects.",
      "properties": {
        "alerts": {
          "items": {
            "$ref": "#/$defs/ScriptAlertEvent"
          },
          "maxItems": 2000,
          "title": "Alerts",
          "type": "array"
        },
        "bar_closes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bar Closes",
          "type": "object"
        },
        "bar_visuals": {
          "items": {
            "$ref": "#/$defs/ScriptVisual"
          },
          "maxItems": 16000,
          "title": "Bar Visuals",
          "type": "array"
        },
        "bars_count": {
          "title": "Bars Count",
          "type": "integer"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "data_source": {
          "title": "Data Source",
          "type": "string"
        },
        "equity_curve": {
          "items": {
            "$ref": "#/$defs/PlotPoint"
          },
          "maxItems": 2000,
          "title": "Equity Curve",
          "type": "array"
        },
        "feed_state": {
          "title": "Feed State",
          "type": "string"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/SimulatedFill"
          },
          "maxItems": 4000,
          "title": "Fills",
          "type": "array"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "indicator",
            "strategy",
            "filter",
            "alert"
          ],
          "title": "Kind",
          "type": "string"
        },
        "matched": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "overlay": {
          "title": "Overlay",
          "type": "boolean"
        },
        "plot_styles": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Plot Styles",
          "type": "object"
        },
        "plots": {
          "items": {
            "$ref": "#/$defs/PlotSeries"
          },
          "maxItems": 64,
          "title": "Plots",
          "type": "array"
        },
        "script_id": {
          "title": "Script Id",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "tf": {
          "title": "Tf",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "visuals": {
          "items": {
            "$ref": "#/$defs/ScriptVisual"
          },
          "maxItems": 500,
          "title": "Visuals",
          "type": "array"
        }
      },
      "required": [
        "script_id",
        "version",
        "kind",
        "source_hash",
        "instrument_id",
        "tf",
        "bars_count",
        "feed_state",
        "data_source",
        "complete",
        "overlay",
        "plots",
        "fills",
        "equity_curve",
        "metrics"
      ],
      "title": "ScriptResult",
      "type": "object"
    },
    "ScriptRun": {
      "additionalProperties": false,
      "description": "Requests a reproducible run using closed, real backend candles.\n\nAttributes:\n    version: Pinned script version, or latest when omitted.\n    instrument_id: Canonical venue:market:symbol identifier.\n    tf: Supported chart timeframe, one second through one calendar month.\n    limit: Maximum closed bars, from two through two thousand.\n    from_ms: Optional inclusive UTC epoch millisecond lower boundary.\n    to_ms: Optional exclusive UTC epoch millisecond visibility boundary.\n    include_open: Evaluate the provisional last bar for indicators only;\n        alerts and simulated orders always require closed bars.\n    inputs: JSON input values overriding the version's defaults.\n    initial_equity: Positive initial simulated cash in quote units.\n    commission_bps: Commission in basis points per simulated fill.\n    slippage_bps: Adverse simulated slippage in basis points per fill.",
      "properties": {
        "commission_bps": {
          "default": 0.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Commission Bps",
          "type": "number"
        },
        "from_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Ms"
        },
        "include_open": {
          "default": false,
          "title": "Include Open",
          "type": "boolean"
        },
        "initial_equity": {
          "default": 10000.0,
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0,
          "title": "Initial Equity",
          "type": "number"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "instrument_id": {
          "pattern": "^(bybit|okx|coinbase|kraken|deriv|binance|hyperliquid|lighter|bitget|mexc|twse|tpex|nasdaq|nyse|cboe|treasury|mock):(perp|spot|future|stock|etf|rate):[A-Za-z0-9._/-]{1,64}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "limit": {
          "default": 500,
          "maximum": 2000,
          "minimum": 2,
          "title": "Limit",
          "type": "integer"
        },
        "slippage_bps": {
          "default": 0.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "to_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Ms"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "instrument_id",
        "tf"
      ],
      "title": "ScriptRun",
      "type": "object"
    },
    "ScriptVersion": {
      "additionalProperties": false,
      "description": "A tenant-visible immutable, content-addressed script version.\n\nAttributes:\n    version: Positive monotonically increasing version number.\n    source_hash: SHA-256 of the source and dependency/input configuration.\n    created_at_ms: Creation time in UTC epoch milliseconds.",
      "properties": {
        "created_at_ms": {
          "title": "Created At Ms",
          "type": "integer"
        },
        "defaults": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Defaults",
          "type": "object"
        },
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "kind": {
          "enum": [
            "indicator",
            "strategy",
            "library",
            "filter",
            "alert"
          ],
          "title": "Kind",
          "type": "string"
        },
        "libraries": {
          "additionalProperties": {
            "$ref": "#/$defs/LibraryRef"
          },
          "title": "Libraries",
          "type": "object"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overlay": {
          "default": true,
          "title": "Overlay",
          "type": "boolean"
        },
        "requests": {
          "additionalProperties": {
            "$ref": "#/$defs/SeriesRequest"
          },
          "maxProperties": 4,
          "title": "Requests",
          "type": "object"
        },
        "script_id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Script Id",
          "type": "string"
        },
        "source": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "script_id",
        "kind",
        "name",
        "source",
        "version",
        "source_hash",
        "created_at_ms"
      ],
      "title": "ScriptVersion",
      "type": "object"
    },
    "ScriptVisual": {
      "additionalProperties": false,
      "description": "A bounded declarative drawing; never executable browser code.\n\nAttributes:\n    id: Stable visual id unique within this script instance.\n    kind: Plot/drawing category interpreted by the chart renderer.\n    data: JSON coordinates, text and presentation; renderers read only\n        documented fields and never inject HTML, CSS URLs or JavaScript.",
      "properties": {
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "line",
            "polyline",
            "box",
            "label",
            "table",
            "fill",
            "hline",
            "linefill",
            "barcolor",
            "bgcolor",
            "shape",
            "candle",
            "bar"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "data"
      ],
      "title": "ScriptVisual",
      "type": "object"
    },
    "SeriesRequest": {
      "additionalProperties": false,
      "description": "Declares another symbol/resolution before isolated indicator execution.\n\nAttributes:\n    instrument_id: Optional canonical symbol; defaults to the chart symbol.\n    tf: Requested resolution, with confirmed-bar visibility enforced by\n        host.\n    limit: Maximum closed source bars, one through five hundred.",
      "properties": {
        "instrument_id": {
          "anyOf": [
            {
              "pattern": "^(bybit|okx|coinbase|kraken|deriv|binance|hyperliquid|lighter|bitget|mexc|twse|tpex|nasdaq|nyse|cboe|treasury|mock):(perp|spot|future|stock|etf|rate):[A-Za-z0-9._/-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "limit": {
          "default": 500,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        }
      },
      "required": [
        "tf"
      ],
      "title": "SeriesRequest",
      "type": "object"
    },
    "SimulatedFill": {
      "additionalProperties": false,
      "description": "An isolated strategy simulation fill, never an executable broker order.\n\nAttributes:\n    time_ms: Fill bar start in UTC epoch milliseconds.\n    side: Buy or sell after converting the signed position target.\n    quantity: Positive base-asset quantity filled.\n    price: Fill price including adverse slippage, in quote/base units.\n    fee: Nonnegative commission in quote units.\n    effect: Entry, exit or reversal for unambiguous chart trade markers.",
      "properties": {
        "effect": {
          "default": "entry",
          "enum": [
            "entry",
            "exit",
            "reversal"
          ],
          "title": "Effect",
          "type": "string"
        },
        "fee": {
          "minimum": 0,
          "title": "Fee",
          "type": "number"
        },
        "price": {
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "time_ms": {
          "title": "Time Ms",
          "type": "integer"
        }
      },
      "required": [
        "time_ms",
        "side",
        "quantity",
        "price",
        "fee"
      ],
      "title": "SimulatedFill",
      "type": "object"
    }
  },
  "$id": "python-scripts.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
