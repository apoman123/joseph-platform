{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.joseph.local/v1/workspace.schema.json",
  "title": "JosephWorkspace",
  "description": "Persisted terminal documents. Drawings use time/price anchors (never pixels) and are scoped by exact instrument. Unknown tools are preserved as opaque documents.",
  "$defs": {
    "DrawingAnchor": {
      "title": "DrawingAnchor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "price"
      ],
      "properties": {
        "time_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "price": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        }
      }
    },
    "DrawingStyle": {
      "title": "DrawingStyle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "line_width",
        "line_style"
      ],
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "line_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Stroke width in CSS pixels (1..50), including broad highlighter strokes."
        },
        "line_style": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "fill_color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "text_color": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 48
        },
        "extend_left": {
          "type": "boolean"
        },
        "extend_right": {
          "type": "boolean"
        },
        "show_labels": {
          "type": "boolean"
        }
      }
    },
    "DrawingDocument": {
      "title": "DrawingDocument",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "drawing_id",
        "tool_id",
        "tool_version",
        "instrument_id",
        "anchors",
        "style",
        "locked",
        "visible",
        "z_index",
        "created_at_ms",
        "updated_at_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "drawing_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string",
          "description": "Plugin id, e.g. `trendline`, `fib-retracement`."
        },
        "tool_version": {
          "type": "integer",
          "minimum": 1
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "timeframe": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Timeframe"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = visible on every timeframe."
        },
        "anchors": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/DrawingAnchor"
          }
        },
        "style": {
          "$ref": "#/$defs/DrawingStyle"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "props": {
          "type": "object",
          "description": "Tool-specific settings, e.g. fib levels or position quantity."
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "z_index": {
          "type": "integer"
        },
        "created_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "updated_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        }
      }
    },
    "DrawingCollection": {
      "title": "DrawingCollection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workspace_id",
        "instrument_id",
        "drawings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "workspace_id": {
          "type": "string"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "drawings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrawingDocument"
          }
        }
      }
    },
    "ChartType": {
      "title": "ChartType",
      "type": "string",
      "enum": [
        "candles",
        "bars",
        "line",
        "area",
        "heikin_ashi"
      ]
    },
    "PriceScaleMode": {
      "title": "PriceScaleMode",
      "type": "string",
      "enum": [
        "linear",
        "log",
        "percent"
      ]
    },
    "StudyState": {
      "title": "StudyState",
      "description": "One study on a chart: a built-in, plugin or owned script instance with its inputs. Built-in and plugin scripts use version 0; owned scripts pin an immutable version.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "script_id",
        "version",
        "kind",
        "name",
        "visible",
        "inputs",
        "colors"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_.#-]{1,160}$",
          "description": "Unique within the chart; the script id, with a #n suffix for further instances."
        },
        "script_id": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9-]{0,62}|builtin:[a-z][a-z0-9_-]{0,63}|plugin:[a-z0-9_.-]{1,64}:[a-z][a-z0-9_-]{0,63})$",
          "description": "Owned script slug, builtin:<id> or plugin:<entry>:<id>."
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "description": "Pinned owned version; 0 for built-in and plugin scripts."
        },
        "kind": {
          "enum": [
            "indicator",
            "strategy",
            "alert"
          ],
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "visible": {
          "type": "boolean"
        },
        "inputs": {
          "type": "object",
          "description": "Input overrides validated by the engine against the script's declared inputs."
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": "Per-plot color overrides by plot name."
        }
      }
    },
    "ChartState": {
      "title": "ChartState",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chart_id",
        "instrument_id",
        "timeframe",
        "chart_type",
        "price_scale",
        "show_volume",
        "studies",
        "feed_mode"
      ],
      "properties": {
        "chart_id": {
          "type": "string"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "timeframe": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "chart_type": {
          "$ref": "#/$defs/ChartType"
        },
        "price_scale": {
          "$ref": "#/$defs/PriceScaleMode"
        },
        "show_volume": {
          "type": "boolean"
        },
        "studies": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/StudyState"
          },
          "description": "Studies in legend order."
        },
        "link_group": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A",
            "B",
            "C",
            "D",
            null
          ]
        },
        "feed_mode": {
          "$ref": "common.schema.json#/$defs/FeedMode"
        },
        "compare": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/InstrumentId"
          },
          "description": "Instruments overlaid on a separate percentage axis."
        },
        "session_separators": {
          "type": "boolean",
          "description": "Draw UTC session boundaries."
        },
        "visible_range": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_ms",
                "to_ms"
              ],
              "properties": {
                "from_ms": {
                  "$ref": "common.schema.json#/$defs/TimestampMs"
                },
                "to_ms": {
                  "$ref": "common.schema.json#/$defs/TimestampMs"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "view_type": {
          "enum": [
            "candles",
            "heatmap"
          ],
          "type": "string",
          "description": "Tab content; omitted means candles for existing workspaces."
        }
      }
    },
    "LayoutId": {
      "title": "LayoutId",
      "type": "string",
      "enum": [
        "1",
        "2h",
        "2v",
        "4",
        "8"
      ]
    },
    "SyncOptions": {
      "title": "SyncOptions",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosshair",
        "instrument",
        "timeframe",
        "viewport"
      ],
      "properties": {
        "crosshair": {
          "type": "boolean"
        },
        "instrument": {
          "type": "boolean"
        },
        "timeframe": {
          "type": "boolean"
        },
        "viewport": {
          "type": "boolean"
        }
      }
    },
    "WorkspaceDocument": {
      "title": "WorkspaceDocument",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workspace_id",
        "name",
        "layout",
        "sync",
        "active_chart_id",
        "charts",
        "updated_at_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "workspace_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "layout": {
          "$ref": "#/$defs/LayoutId"
        },
        "sync": {
          "$ref": "#/$defs/SyncOptions"
        },
        "active_chart_id": {
          "type": "string"
        },
        "charts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ChartState"
          },
          "description": "Saved chart tabs without a fixed count limit; layout controls visible panes."
        },
        "favorites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeframes": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Timeframe"
              }
            },
            "instruments": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/InstrumentId"
              }
            }
          }
        },
        "panels": {
          "type": "object",
          "description": "Opaque per-feature panel state keyed by feature id."
        },
        "updated_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        }
      }
    },
    "WorkspaceExportDrawings": {
      "title": "WorkspaceExportDrawings",
      "description": "Drawings of one exact instrument inside a workspace export.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "drawings"
      ],
      "properties": {
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "drawings": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/DrawingDocument"
          }
        },
        "opaque": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          },
          "description": "Stored drawing payloads this build cannot read (for example a newer drawing schema). Exported and restored verbatim, never deleted (ADR 0007)."
        }
      }
    },
    "WorkspaceExport": {
      "title": "WorkspaceExport",
      "description": "Workspace export file, format version 2: the workspace document plus the drawings of its instruments. Import also accepts a plain WorkspaceDocument (export format 1, no drawings) and the V4 starter shape (format 0), migrated step by step; schema v1 documents are migrated to v2 (indicator layers and attached scripts become studies); drawings of unknown tools are kept.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "exported_at_ms",
        "workspace",
        "drawings"
      ],
      "properties": {
        "format": {
          "const": "joseph.workspace-export"
        },
        "schema_version": {
          "const": 2
        },
        "exported_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceDocument"
        },
        "drawings": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/WorkspaceExportDrawings"
          }
        }
      }
    }
  }
}
