{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.joseph.local/v1/strategy.schema.json",
  "title": "JosephStrategy",
  "description": "Rule AST v2. The visual builder emits this typed tree; no code is ever evaluated. The same evaluator runs backtest, replay, paper, shadow and live. Unknown or stale inputs evaluate to UNKNOWN, which blocks entries.",
  "$defs": {
    "AllNode": {
      "title": "AllNode",
      "description": "TRUE when every child is TRUE; FALSE when any child is FALSE; otherwise UNKNOWN.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "children"
      ],
      "properties": {
        "op": {
          "const": "ALL"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/RuleNode"
          }
        }
      }
    },
    "AnyNode": {
      "title": "AnyNode",
      "description": "TRUE when any child is TRUE; FALSE when every child is FALSE; otherwise UNKNOWN.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "children"
      ],
      "properties": {
        "op": {
          "const": "ANY"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/RuleNode"
          }
        }
      }
    },
    "NotNode": {
      "title": "NotNode",
      "description": "Negation; NOT UNKNOWN is UNKNOWN.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "child"
      ],
      "properties": {
        "op": {
          "const": "NOT"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "child": {
          "$ref": "#/$defs/RuleNode"
        }
      }
    },
    "ValueMatch": {
      "title": "ValueMatch",
      "description": "One STATE clause: the published value `field` equals one of `any_of`, compared with the same JSON type (a string never equals a boolean).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "any_of"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 64
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "StateNode": {
      "title": "StateNode",
      "description": "Indicator state on one or more timeframes, read only from bars closed at or before the evaluated bar close. A timeframe counts when every `where` clause matches the latest warm snapshot of `plugin_id`; a null or missing value does not match, and a missing snapshot is UNKNOWN. match=ALL requires every timeframe; K_OF_N requires k of them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "plugin_id",
        "timeframes",
        "where"
      ],
      "properties": {
        "op": {
          "const": "STATE"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "plugin_id": {
          "$ref": "indicators.schema.json#/$defs/PluginId"
        },
        "timeframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "common.schema.json#/$defs/Timeframe"
          }
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ValueMatch"
          }
        },
        "match": {
          "type": "string",
          "enum": [
            "ALL",
            "K_OF_N"
          ],
          "default": "ALL"
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "InZoneNode": {
      "title": "InZoneNode",
      "description": "The price is inside [lower, upper] of a live AOI of `kinds` (and `side`, when given) detected on `tf`, read from the snapshots of the plugins that publish those kinds. Nodes sharing a `group` must agree on the AOI `group_id`: the binding is the intersection of the group ids among each member's live candidate AOIs, and a member is TRUE only when a containing AOI's group id is in the binding. A missing member snapshot makes the binding UNKNOWN.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "kinds",
        "tf"
      ],
      "properties": {
        "op": {
          "const": "IN_ZONE"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "indicators.schema.json#/$defs/AoiKind"
          }
        },
        "side": {
          "type": "string",
          "enum": [
            "bullish",
            "bearish"
          ]
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "price_source": {
          "type": "string",
          "enum": [
            "close",
            "high",
            "low",
            "hl2"
          ],
          "default": "close"
        },
        "group": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "AoiTouchNode": {
      "title": "AoiTouchNode",
      "description": "A closed signal-timeframe bar within the last `within_bars` bars (0 = current bar only) touched an AOI that was already confirmed before that bar. touch=WICK uses high/low intersection, BODY uses open/close, CLOSE uses close inside the zone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "kinds",
        "side",
        "within_bars"
      ],
      "properties": {
        "op": {
          "const": "AOI_TOUCH"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "indicators.schema.json#/$defs/AoiKind"
          }
        },
        "side": {
          "type": "string",
          "enum": [
            "bullish",
            "bearish"
          ]
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe",
          "description": "Timeframe the AOI was detected on; defaults to the signal timeframe."
        },
        "within_bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "touch": {
          "type": "string",
          "enum": [
            "WICK",
            "BODY",
            "CLOSE"
          ],
          "default": "WICK"
        },
        "require_active": {
          "type": "boolean",
          "default": true
        },
        "min_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "AoiOverlapNode": {
      "title": "AoiOverlapNode",
      "description": "An active AOI of kinds_a overlaps an active AOI of kinds_b by at least min_overlap_pct of the smaller zone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "kinds_a",
        "kinds_b",
        "side"
      ],
      "properties": {
        "op": {
          "const": "AOI_OVERLAP"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "kinds_a": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "indicators.schema.json#/$defs/AoiKind"
          }
        },
        "kinds_b": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "indicators.schema.json#/$defs/AoiKind"
          }
        },
        "side": {
          "type": "string",
          "enum": [
            "bullish",
            "bearish"
          ]
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "min_overlap_pct": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        }
      }
    },
    "EventRef": {
      "title": "EventRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "indicators.schema.json#/$defs/StructureEventName"
        },
        "source": {
          "$ref": "indicators.schema.json#/$defs/PluginId",
          "description": "Plugin that must publish the event; events of that name from any plugin count when omitted."
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        }
      }
    },
    "EventNode": {
      "title": "EventNode",
      "description": "An indicator event confirmed within the last `within_bars` closed bars (0 = current bar).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "name",
        "within_bars"
      ],
      "properties": {
        "op": {
          "const": "EVENT"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "$ref": "indicators.schema.json#/$defs/StructureEventName"
        },
        "source": {
          "$ref": "indicators.schema.json#/$defs/PluginId",
          "description": "Plugin that must publish the event; events of that name from any plugin count when omitted."
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "within_bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "SequenceNode": {
      "title": "SequenceNode",
      "description": "Ordered events on distinct closed bars inside a window of `within_bars` bars. The final step must occur on the evaluated bar, so a completed sequence fires once.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "within_bars",
        "steps"
      ],
      "properties": {
        "op": {
          "const": "SEQUENCE"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "within_bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/EventRef"
          }
        }
      }
    },
    "ConstOperand": {
      "title": "ConstOperand",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "const"
        },
        "value": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        }
      }
    },
    "CandleOperand": {
      "title": "CandleOperand",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "candle"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "field": {
          "type": "string",
          "enum": [
            "open",
            "high",
            "low",
            "close",
            "base_volume"
          ]
        },
        "bars_ago": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "default": 0
        }
      }
    },
    "IndicatorOperand": {
      "title": "IndicatorOperand",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "plugin_id",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "indicator"
        },
        "plugin_id": {
          "type": "string"
        },
        "tf": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "field": {
          "type": "string",
          "maxLength": 64
        },
        "bars_ago": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "default": 0
        }
      }
    },
    "MarketOperand": {
      "title": "MarketOperand",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "market"
        },
        "field": {
          "type": "string",
          "enum": [
            "funding_8h_pct",
            "open_interest_usd",
            "oi_change_pct",
            "spread_pct",
            "turnover_24h_quote"
          ]
        }
      }
    },
    "Operand": {
      "title": "Operand",
      "oneOf": [
        {
          "$ref": "#/$defs/ConstOperand"
        },
        {
          "$ref": "#/$defs/CandleOperand"
        },
        {
          "$ref": "#/$defs/IndicatorOperand"
        },
        {
          "$ref": "#/$defs/MarketOperand"
        }
      ]
    },
    "CompareNode": {
      "title": "CompareNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "left",
        "cmp",
        "right"
      ],
      "properties": {
        "op": {
          "const": "COMPARE"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "cmp": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "neq"
          ]
        },
        "right": {
          "$ref": "#/$defs/Operand"
        }
      }
    },
    "InRangeNode": {
      "title": "InRangeNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "value",
        "low",
        "high"
      ],
      "properties": {
        "op": {
          "const": "IN_RANGE"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "$ref": "#/$defs/Operand"
        },
        "low": {
          "$ref": "#/$defs/Operand"
        },
        "high": {
          "$ref": "#/$defs/Operand"
        },
        "inclusive": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "CrossesNode": {
      "title": "CrossesNode",
      "description": "left crossed right between the previous and the evaluated closed bar.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "left",
        "right",
        "direction"
      ],
      "properties": {
        "op": {
          "const": "CROSSES"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        },
        "direction": {
          "type": "string",
          "enum": [
            "ABOVE",
            "BELOW"
          ]
        }
      }
    },
    "PersistForNode": {
      "title": "PersistForNode",
      "description": "child is TRUE on each of the last `bars` closed bars including the evaluated bar.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "bars",
        "child"
      ],
      "properties": {
        "op": {
          "const": "PERSIST_FOR"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "child": {
          "$ref": "#/$defs/RuleNode"
        }
      }
    },
    "WithinBarsNode": {
      "title": "WithinBarsNode",
      "description": "child is TRUE on at least one of the last `bars` + 1 closed bars.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "bars",
        "child"
      ],
      "properties": {
        "op": {
          "const": "WITHIN_BARS"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "child": {
          "$ref": "#/$defs/RuleNode"
        }
      }
    },
    "LocalTimeWindow": {
      "title": "LocalTimeWindow",
      "description": "Local-time window [start, end); an end at or before the start wraps past midnight.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "TimeWindowNode": {
      "title": "TimeWindowNode",
      "description": "The evaluated bar starts, in `time_zone` local time, inside one of `windows`, on one of `weekdays` (ISO local weekday, 1 = Monday; every day when omitted).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "time_zone",
        "windows"
      ],
      "properties": {
        "op": {
          "const": "TIME_WINDOW"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone, e.g. America/New_York."
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/LocalTimeWindow"
          }
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "RiskRewardNode": {
      "title": "RiskRewardNode",
      "description": "Projected reward/risk net of estimated costs from the strategy risk model is at least min_rr.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "min_rr"
      ],
      "properties": {
        "op": {
          "const": "RISK_REWARD"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "min_rr": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        }
      }
    },
    "RuleNode": {
      "title": "RuleNode",
      "description": "Discriminated union on `op`.",
      "oneOf": [
        {
          "$ref": "#/$defs/AllNode"
        },
        {
          "$ref": "#/$defs/AnyNode"
        },
        {
          "$ref": "#/$defs/NotNode"
        },
        {
          "$ref": "#/$defs/StateNode"
        },
        {
          "$ref": "#/$defs/InZoneNode"
        },
        {
          "$ref": "#/$defs/AoiTouchNode"
        },
        {
          "$ref": "#/$defs/AoiOverlapNode"
        },
        {
          "$ref": "#/$defs/EventNode"
        },
        {
          "$ref": "#/$defs/SequenceNode"
        },
        {
          "$ref": "#/$defs/CompareNode"
        },
        {
          "$ref": "#/$defs/InRangeNode"
        },
        {
          "$ref": "#/$defs/CrossesNode"
        },
        {
          "$ref": "#/$defs/PersistForNode"
        },
        {
          "$ref": "#/$defs/WithinBarsNode"
        },
        {
          "$ref": "#/$defs/TimeWindowNode"
        },
        {
          "$ref": "#/$defs/RiskRewardNode"
        }
      ]
    },
    "Universe": {
      "title": "Universe",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "venues"
      ],
      "properties": {
        "qualification": {
          "type": "string",
          "enum": [
            "QUALIFIED_ONLY",
            "ANY"
          ]
        },
        "venues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/Venue"
          }
        },
        "whitelist": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InstrumentId"
          }
        },
        "blacklist": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InstrumentId"
          }
        },
        "min_qualified_minutes": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "RiskModel": {
      "title": "RiskModel",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_rr",
        "stop_model",
        "target_model"
      ],
      "properties": {
        "min_rr": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "stop_model": {
          "type": "string",
          "enum": [
            "AOI_INVALIDATION",
            "SWING",
            "ATR"
          ]
        },
        "stop_buffer_atr": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "target_model": {
          "description": "NEAREST_AOI targets the nearest live AOI of `target_kinds` beyond the entry (its lower bound above a LONG entry, its upper bound below a SHORT entry); FIXED_R targets `fixed_r` times the risk.",
          "type": "string",
          "enum": [
            "NEAREST_AOI",
            "FIXED_R"
          ]
        },
        "target_kinds": {
          "description": "AOI kinds NEAREST_AOI may target.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "indicators.schema.json#/$defs/AoiKind"
          }
        },
        "fixed_r": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "fee_bps_estimate": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "max_risk_pct_equity": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        }
      }
    },
    "SignalKind": {
      "title": "SignalKind",
      "type": "string",
      "enum": [
        "WATCHING_AOI",
        "PRE_SIGNAL",
        "ENTRY_CONFIRMED",
        "ENTRY_BLOCKED",
        "AOI_INVALIDATED",
        "SETUP_EXPIRED",
        "QUALIFICATION_CHANGED",
        "POSITION_EXITED"
      ]
    },
    "NotificationPolicy": {
      "title": "NotificationPolicy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooldown_bars",
        "once_per_aoi"
      ],
      "properties": {
        "cooldown_bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "once_per_aoi": {
          "type": "boolean"
        },
        "emit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalKind"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UI",
              "TELEGRAM",
              "LINE",
              "EMAIL",
              "WEBHOOK"
            ]
          }
        }
      }
    },
    "SetupPolicy": {
      "title": "SetupPolicy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expire_after_bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 24
        }
      }
    },
    "DataPolicy": {
      "title": "DataPolicy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_data_age_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 120000
        },
        "allow_rest_poll": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "StrategyDefinition": {
      "title": "StrategyDefinition",
      "description": "User-authored strategy. Immutable once stored as a StrategyVersion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "strategy_id",
        "name",
        "direction",
        "signal_timeframe",
        "universe",
        "when",
        "risk",
        "notification",
        "execution_mode"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "strategy_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "direction": {
          "$ref": "common.schema.json#/$defs/Direction"
        },
        "signal_timeframe": {
          "$ref": "common.schema.json#/$defs/Timeframe"
        },
        "universe": {
          "$ref": "#/$defs/Universe"
        },
        "when": {
          "$ref": "#/$defs/RuleNode"
        },
        "risk": {
          "$ref": "#/$defs/RiskModel"
        },
        "notification": {
          "$ref": "#/$defs/NotificationPolicy"
        },
        "setup": {
          "$ref": "#/$defs/SetupPolicy"
        },
        "data_policy": {
          "$ref": "#/$defs/DataPolicy"
        },
        "execution_mode": {
          "$ref": "common.schema.json#/$defs/ExecutionMode",
          "description": "Requested mode. AUTO_LIVE additionally needs an execution-engine deployment with explicit consent."
        }
      }
    },
    "StrategyState": {
      "title": "StrategyState",
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "ACTIVE",
        "PAUSED",
        "ARCHIVED",
        "UNSUPPORTED"
      ]
    },
    "Activation": {
      "title": "Activation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "activated_at_ms"
      ],
      "properties": {
        "mode": {
          "$ref": "common.schema.json#/$defs/ExecutionMode"
        },
        "activated_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InstrumentId"
          }
        }
      }
    },
    "StrategyVersion": {
      "title": "StrategyVersion",
      "description": "Immutable stored version. Editing creates a new version; live permissions never carry over.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_version_id",
        "strategy_id",
        "version",
        "tenant_id",
        "author_user_id",
        "created_at_ms",
        "definition",
        "definition_hash",
        "compiler_version",
        "evaluator_version",
        "state"
      ],
      "properties": {
        "strategy_version_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}:v[1-9][0-9]*$"
        },
        "strategy_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string"
        },
        "author_user_id": {
          "type": "string"
        },
        "created_at_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "definition": {
          "$ref": "#/$defs/StrategyDefinition"
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compiler_version": {
          "type": "string"
        },
        "evaluator_version": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StrategyState"
        },
        "activation": {
          "oneOf": [
            {
              "$ref": "#/$defs/Activation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StrategyVersionList": {
      "title": "StrategyVersionList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions"
      ],
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StrategyVersion"
          }
        }
      }
    },
    "ValidationIssue": {
      "title": "ValidationIssue",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "JSON pointer into the definition."
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ValidationResult": {
      "title": "ValidationResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "errors",
        "warnings",
        "required_plugins",
        "required_timeframes",
        "node_count",
        "max_depth"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          }
        },
        "required_plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_timeframes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Timeframe"
          }
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "definition_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ActivateRequest": {
      "title": "ActivateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "ALERT_ONLY",
            "PAPER",
            "SHADOW"
          ],
          "description": "AUTO_LIVE cannot be activated here; it requires an execution-engine deployment with consent."
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InstrumentId"
          }
        }
      }
    },
    "BacktestRequest": {
      "title": "BacktestRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "instrument_id",
        "from_ms",
        "to_ms"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "from_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "to_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "fee_bps": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "slippage_bps": {
          "$ref": "common.schema.json#/$defs/NonNegativeDecimalString"
        },
        "max_hold_bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "BacktestTrade": {
      "title": "BacktestTrade",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "direction",
        "entry_ms",
        "entry_price",
        "stop_price",
        "target_price",
        "exit_ms",
        "exit_price",
        "exit_reason",
        "r_multiple",
        "fees_r",
        "hold_bars"
      ],
      "properties": {
        "signal_id": {
          "type": "string"
        },
        "direction": {
          "$ref": "common.schema.json#/$defs/Direction"
        },
        "entry_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "entry_price": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "stop_price": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "target_price": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "exit_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "exit_price": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "exit_reason": {
          "type": "string",
          "enum": [
            "STOP",
            "TARGET",
            "TIMEOUT",
            "END_OF_DATA"
          ]
        },
        "r_multiple": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "fees_r": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "hold_bars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "BacktestMetrics": {
      "title": "BacktestMetrics",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trades",
        "wins",
        "losses",
        "win_rate",
        "expectancy_r",
        "profit_factor",
        "max_drawdown_r",
        "avg_r",
        "avg_hold_bars"
      ],
      "properties": {
        "trades": {
          "type": "integer",
          "minimum": 0
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "losses": {
          "type": "integer",
          "minimum": 0
        },
        "win_rate": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectancy_r": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "profit_factor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_drawdown_r": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "avg_r": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "avg_hold_bars": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BacktestReport": {
      "title": "BacktestReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backtest_id",
        "strategy_version_id",
        "instrument_id",
        "from_ms",
        "to_ms",
        "bars_evaluated",
        "signals",
        "trades",
        "metrics",
        "missing_bars",
        "feed_state",
        "assumptions",
        "evaluator_version"
      ],
      "properties": {
        "backtest_id": {
          "type": "string"
        },
        "strategy_version_id": {
          "type": "string"
        },
        "instrument_id": {
          "$ref": "common.schema.json#/$defs/InstrumentId"
        },
        "from_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "to_ms": {
          "$ref": "common.schema.json#/$defs/TimestampMs"
        },
        "bars_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "signal.schema.json#/$defs/Signal"
          }
        },
        "trades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BacktestTrade"
          }
        },
        "metrics": {
          "$ref": "#/$defs/BacktestMetrics"
        },
        "missing_bars": {
          "type": "integer",
          "minimum": 0
        },
        "feed_state": {
          "$ref": "common.schema.json#/$defs/FeedState"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluator_version": {
          "type": "string"
        }
      }
    }
  }
}
