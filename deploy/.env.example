# Copy to deploy/.env and replace every "change-me" value.
# Generate secrets with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
IMAGE_REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest

JOSEPH_ENV=development
# Development bearer tokens (token:tenant:user). Leave empty in production
# (JOSEPH_ENV=production refuses them) and put a real identity layer in front.
JOSEPH_DEV_TOKENS=change-me-dev-token:tenant-01:user-01
JOSEPH_SERVICE_TOKEN=change-me-service-token
JOSEPH_VAULT_MASTER_KEY=change-me-base64-32-bytes
JOSEPH_PREVIEW_SECRET=change-me-base64-32-bytes
JOSEPH_STEP_UP_TOTP_SECRET=
JOSEPH_CORS_ORIGINS=http://localhost:3000

# Live trading (execution engine). The gate is ON for this deployment;
# accounts still trade only after their venue keys are stored (encrypted)
# and verified, and every order passes the Risk Gateway, preview/consent
# with step-up and the kill switch. Set false to stop all new live orders.
JOSEPH_LIVE_TRADING_ENABLED=true
JOSEPH_EMERGENCY_HALT=false
# Venues whose accounts default to the test environment (binance testnet,
# bitget demo, hyperliquid/lighter testnet); "all" or a comma list. An
# account's own "environment" credential field overrides this.
JOSEPH_VENUE_SANDBOX=
# Endpoint overrides, e.g. binance.testnet_rest_url=https://testnet.binancefuture.com
JOSEPH_VENUE_URLS=
JOSEPH_VENUE_TIMEOUT_S=10
JOSEPH_VENUE_MARKET_SLIPPAGE_BPS=50
JOSEPH_LIVE_STREAMS=true

JOSEPH_ENABLED_VENUES=binance,hyperliquid,lighter,bitget,mexc,mock
JOSEPH_DEMO_ONLY=false

# Optional notification channels.
JOSEPH_TELEGRAM_BOT_TOKEN=
JOSEPH_LINE_CHANNEL_TOKEN=
JOSEPH_WEBHOOK_SECRET=
JOSEPH_SMTP_HOST=
JOSEPH_SMTP_FROM=
JOSEPH_SMTP_USERNAME=
JOSEPH_SMTP_PASSWORD=

# Browser-facing URLs baked into the web image at build time.
PUBLIC_MARKET_API_URL=http://localhost:8000
PUBLIC_MARKET_WS_URL=ws://localhost:8000
PUBLIC_EXECUTION_API_URL=http://localhost:8100
PUBLIC_EXECUTION_WS_URL=ws://localhost:8100
PUBLIC_DEV_TOKEN=change-me-dev-token
