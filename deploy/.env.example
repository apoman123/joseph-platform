# Copy to deploy/.env and replace every "change-me" value.
# Generate secrets with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
IMAGE_REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest

# Only the execution engine reads JOSEPH_ENV: any value other than
# development requires JOSEPH_VAULT_MASTER_KEY.
JOSEPH_ENV=development
# Bearer tokens (token:tenant:user) both engines accept in every
# environment: use long random values, or leave it empty behind a real
# identity layer.
JOSEPH_DEV_TOKENS=change-me-dev-token:tenant-01:user-01
# Authenticates the engine-to-engine /internal calls (required).
JOSEPH_SERVICE_TOKEN=change-me-service-token
# Base64 of exactly 32 bytes (the command above). An empty key in
# development becomes a per-process key: stored credentials are then lost
# on every restart.
JOSEPH_VAULT_MASTER_KEY=change-me-base64-32-bytes
# Preview token key, used as given; empty means a per-process key, so
# previews do not survive a restart.
JOSEPH_PREVIEW_SECRET=change-me-base64-32-bytes
# Base32 TOTP (time-based one-time password) secret for step-up codes,
# e.g. python3 -c "import base64,secrets;print(base64.b32encode(secrets.token_bytes(20)).decode())".
# Empty: every step-up fails, so no account can be armed for LIVE and no
# AUTO_LIVE consent can be granted.
JOSEPH_STEP_UP_TOTP_SECRET=
# Longest (and default) account LIVE arming for manual orders, in ms
# (8 h; the engine refuses anything above 24 h at startup).
JOSEPH_LIVE_ARM_MAX_MS=28800000
JOSEPH_CORS_ORIGINS=http://localhost:3000

# Live trading (execution engine). The gate is ON for this deployment;
# accounts still trade only after their venue keys are stored (encrypted)
# and verified, every order needs an ALLOW from the Risk Gateway (kill
# switches and JOSEPH_EMERGENCY_HALT included), manual orders also need a
# preview and an account armed with a step-up code, and AUTO_LIVE orders a
# step-up consent. Set false to stop all new live orders.
JOSEPH_LIVE_TRADING_ENABLED=true
JOSEPH_EMERGENCY_HALT=false
# Venues whose accounts default to the test environment (binance testnet,
# bitget demo, hyperliquid/lighter testnet); "all" or a comma list. An
# account's own "environment" credential field overrides this.
JOSEPH_VENUE_SANDBOX=
# Endpoint overrides, e.g. binance.testnet_rest_url=https://testnet.binancefuture.com
JOSEPH_VENUE_URLS=
# Venue HTTP timeout in seconds.
JOSEPH_VENUE_TIMEOUT_S=10
# Worst-price band of Hyperliquid/Lighter market orders, in basis points.
JOSEPH_VENUE_MARKET_SLIPPAGE_BPS=50
# Private account streams of live crypto accounts (needs the LIVE gate).
JOSEPH_LIVE_STREAMS=true

# Market-data venues only. This list does not enable or disable any trading
# adapter in the execution engine. JOSEPH_DEMO_ONLY=true uses only mock data.
JOSEPH_ENABLED_VENUES=binance,bybit,okx,coinbase,kraken,deriv,twse,tpex,nasdaq,nyse,cboe,treasury
JOSEPH_DEMO_ONLY=false

# US stocks (nasdaq, nyse, cboe): free Alpaca IEX data only. An Alpaca
# market-data key is required; without one the venues report "not configured".
JOSEPH_ALPACA_KEY_ID=
JOSEPH_ALPACA_SECRET_KEY=
JOSEPH_ALPACA_FEED=iex
# Taiwan market data uses Fugle free-tier REST and requires a key.
# This choice does not change SinoPac trading in the execution engine.
JOSEPH_TW_DATA_SOURCE=fugle
# Legacy name: controls historical adjustment for ALL supported timeframes.
JOSEPH_FUGLE_ADJUSTED_DAILY=true
JOSEPH_FUGLE_API_KEY=
# Optional FRED daily yield and spread series; Treasury official data is
# available without a key. FRED_DGS10 and UST10Y remain distinct series.
JOSEPH_FRED_API_KEY=
MARKET_UV_EXTRAS=

# Indicator plugins (docs/OPERATIONS.md#indicator-plugins). The nine
# built-ins are always installed. Image build: space-separated pip
# requirements of plugin packages, installed without dependencies (list
# them all), e.g. git+https://github.com/<owner>/<repo>.git@<commit>;
# empty builds the built-ins only. PLUGIN_GIT_TOKEN: read-only token for
# private https://github.com/ requirements (a BuildKit secret, never in
# the image). MARKET_IMAGE_LICENSES: SPDX licence label of an image that
# contains plugins.
MARKET_PLUGIN_REQUIREMENTS=
PLUGIN_GIT_TOKEN=
MARKET_IMAGE_LICENSES=MIT
# Runtime: entry points to load ("*" all, "none", or names), plugin ids
# to disable, and plugin ids that must load or the engine refuses to
# start.
JOSEPH_INDICATOR_PLUGIN_PACKAGES=*
JOSEPH_INDICATOR_PLUGINS_DISABLED=
JOSEPH_INDICATOR_PLUGINS_REQUIRED=
# MEXC market stream: protobuf (MEXC retires JSON pushes on 2026-12-01
# 10:00 UTC).
JOSEPH_MEXC_WS_FORMAT=protobuf
# Recorded trades (seconds bars, true delta) and public trade archives.
JOSEPH_TRADE_RECORDING=true
JOSEPH_TRADE_BAR_RETENTION_DAYS=30
JOSEPH_TRADE_ARCHIVE_URL=
JOSEPH_BINANCE_ARCHIVE=true
JOSEPH_BITGET_ARCHIVE=true
JOSEPH_LIGHTER_ARCHIVE=true

# Optional notification channels.
JOSEPH_TELEGRAM_BOT_TOKEN=
# Official Meta WhatsApp Cloud API; approved template with one BODY parameter.
JOSEPH_WHATSAPP_ACCESS_TOKEN=
JOSEPH_WHATSAPP_PHONE_NUMBER_ID=
JOSEPH_WHATSAPP_TEMPLATE=
JOSEPH_WHATSAPP_LANGUAGE=en_US
JOSEPH_WHATSAPP_API_VERSION=v27.0
# Encrypted background browser/mobile push. See README: Alert delivery.
JOSEPH_WEB_PUSH_PRIVATE_KEY=
JOSEPH_WEB_PUSH_PUBLIC_KEY=
JOSEPH_WEB_PUSH_CONTACT=
JOSEPH_LINE_CHANNEL_TOKEN=
JOSEPH_WEBHOOK_SECRET=
JOSEPH_SMTP_HOST=
JOSEPH_SMTP_FROM=
JOSEPH_SMTP_USERNAME=
JOSEPH_SMTP_PASSWORD=

# Browser-facing URLs baked into the web image at build time.
PUBLIC_MARKET_API_URL=http://localhost:8000
PUBLIC_MARKET_WS_URL=ws://localhost:8000
PUBLIC_EXECUTION_API_URL=http://localhost:8100
PUBLIC_EXECUTION_WS_URL=ws://localhost:8100
# A token from JOSEPH_DEV_TOKENS; it ships in the browser bundle, so anyone
# who can load the terminal can use it.
PUBLIC_DEV_TOKEN=change-me-dev-token

# --- Securities brokers (docs/BROKERS.md) -----------------------------
# The global LIVE gate (JOSEPH_LIVE_TRADING_ENABLED, above) covers brokers
# too; broker connections stay disabled until enabled below.
# reject (default) or queue: market orders while the exchange is closed.
JOSEPH_EQUITY_CLOSED_MARKET_ORDERS=reject
# Starting cash of the TWD paper account (TWSE, TPEx); 0, off or none
# disables that account.
JOSEPH_PAPER_TWD_STARTING_CASH=3000000
# TWD accounts: money limits and hard caps are the USD values times this.
JOSEPH_TWD_LIMIT_FACTOR=30
# Image build: include broker SDKs.
EXECUTION_UV_EXTRAS=--extra ibkr --extra sinopac
# Secret files live here (never commit them): ibkr_password,
# ibkr_vnc_password, sinopac_api_key, sinopac_secret_key,
# sinopac_ca_password, sinopac_person_id, Sinopac.pfx. The engines and IB
# Gateway see this directory read-only at /run/joseph-secrets: point the
# JOSEPH_*_FILE, JOSEPH_SINOPAC_CA_PATH and IBKR_VNC_PASSWORD_FILE
# settings there.
JOSEPH_SECRETS_DIR=./secrets

# Interactive Brokers (run with --profile ibkr).
IBKR_USERNAME=
IBKR_PASSWORD_FILE=./secrets/ibkr_password
IBKR_TRADING_MODE=paper
# VNC for the first two-factor login: a path inside IB Gateway, e.g.
# /run/joseph-secrets/ibkr_vnc_password; empty turns VNC off.
IBKR_VNC_PASSWORD_FILE=
JOSEPH_IBKR_ENABLED=false
JOSEPH_IBKR_HOST=ib-gateway
# 4004 = paper, 4003 = live (container relays); keep JOSEPH_IBKR_PAPER in
# step (the engine refuses a mismatch at startup).
JOSEPH_IBKR_PORT=4004
JOSEPH_IBKR_PAPER=true
JOSEPH_IBKR_SHORT_SELLING=false
JOSEPH_IBKR_READONLY=false

# SinoPac Shioaji (simulation until SinoPac approves production).
JOSEPH_SINOPAC_ENABLED=false
JOSEPH_SINOPAC_SIMULATION=true
JOSEPH_SINOPAC_API_KEY_FILE=
JOSEPH_SINOPAC_SECRET_KEY_FILE=
JOSEPH_SINOPAC_CA_PATH=
JOSEPH_SINOPAC_CA_PASSWORD_FILE=
JOSEPH_SINOPAC_PERSON_ID_FILE=

# MCP starts with the market engine; use its canonical external HTTP(S) URL.
JOSEPH_MCP_PUBLIC_URL=http://localhost:8000/mcp
# Optional secret of at least 32 bytes; otherwise generated/persisted in DB.
JOSEPH_MCP_SIGNING_KEY_FILE=
# Optional isolated user Python execution (make script-runner first).
JOSEPH_SCRIPT_RUNTIME=disabled
JOSEPH_SCRIPT_RUNNER_IMAGE=joseph-python-runner:1
JOSEPH_SCRIPT_TIMEOUT_S=10
# Containerized execution also needs deploy/docker-compose.scripts.yml.
# DOCKER_GID=1000
# JOSEPH_DOCKER_SOCKET=/run/user/1000/docker.sock
