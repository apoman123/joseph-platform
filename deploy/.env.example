# Copy to deploy/.env and replace every "change-me" value.
# Generate secrets with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
IMAGE_REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=latest

JOSEPH_ENV=development
# Bearer tokens (token:tenant:user) the engines accept. JOSEPH_ENV=production
# drops the built-in development tokens and requires JOSEPH_VAULT_MASTER_KEY,
# but tokens listed here still work: use long random values, or leave it
# empty behind a real identity layer.
JOSEPH_DEV_TOKENS=change-me-dev-token:tenant-01:user-01
JOSEPH_SERVICE_TOKEN=change-me-service-token
JOSEPH_VAULT_MASTER_KEY=change-me-base64-32-bytes
JOSEPH_PREVIEW_SECRET=change-me-base64-32-bytes
JOSEPH_STEP_UP_TOTP_SECRET=
# Longest (and default) account LIVE arming for manual orders, in ms
# (8 h; the engine refuses anything above 24 h at startup).
JOSEPH_LIVE_ARM_MAX_MS=28800000
JOSEPH_CORS_ORIGINS=http://localhost:3000

# Live trading (execution engine). The gate is ON for this deployment;
# accounts still trade only after their venue keys are stored (encrypted)
# and verified, and every order passes the Risk Gateway, preview/consent
# with step-up and the kill switch. Set false to stop all new live orders.
JOSEPH_LIVE_TRADING_ENABLED=true
JOSEPH_EMERGENCY_HALT=false
# Venues whose accounts default to the test environment (binance testnet,
# bitget demo, hyperliquid/lighter testnet); "all" or a comma list. An
# account's own "environment" credential field overrides this.
JOSEPH_VENUE_SANDBOX=
# Endpoint overrides, e.g. binance.testnet_rest_url=https://testnet.binancefuture.com
JOSEPH_VENUE_URLS=
JOSEPH_VENUE_TIMEOUT_S=10
JOSEPH_VENUE_MARKET_SLIPPAGE_BPS=50
JOSEPH_LIVE_STREAMS=true

JOSEPH_ENABLED_VENUES=binance,hyperliquid,lighter,bitget,mexc,twse,tpex,nasdaq,nyse,cboe,treasury,mock
JOSEPH_DEMO_ONLY=false

# US stocks (nasdaq, nyse, cboe): free Alpaca market-data key. Feed: iex
# (real time, IEX volume only), delayed_sip (all volume, 15 min late) or
# sip (paid). Without a key those venues report "not configured".
JOSEPH_ALPACA_KEY_ID=
JOSEPH_ALPACA_SECRET_KEY=
JOSEPH_ALPACA_FEED=iex
# Taiwan intraday source: twse (official, keyless) or sinopac (Shioaji;
# uses the SinoPac key files below and MARKET_UV_EXTRAS=--extra sinopac).
JOSEPH_TW_DATA_SOURCE=twse
MARKET_UV_EXTRAS=
# MEXC market stream: protobuf (JSON is retired on 2026-12-01).
JOSEPH_MEXC_WS_FORMAT=protobuf
# Recorded trades (seconds bars, true delta) and public trade archives.
JOSEPH_TRADE_RECORDING=true
JOSEPH_TRADE_BAR_RETENTION_DAYS=30
JOSEPH_TRADE_ARCHIVE_URL=
JOSEPH_BINANCE_ARCHIVE=true
JOSEPH_BITGET_ARCHIVE=true
JOSEPH_LIGHTER_ARCHIVE=true

# Optional notification channels.
JOSEPH_TELEGRAM_BOT_TOKEN=
JOSEPH_LINE_CHANNEL_TOKEN=
JOSEPH_WEBHOOK_SECRET=
JOSEPH_SMTP_HOST=
JOSEPH_SMTP_FROM=
JOSEPH_SMTP_USERNAME=
JOSEPH_SMTP_PASSWORD=

# Browser-facing URLs baked into the web image at build time.
PUBLIC_MARKET_API_URL=http://localhost:8000
PUBLIC_MARKET_WS_URL=ws://localhost:8000
PUBLIC_EXECUTION_API_URL=http://localhost:8100
PUBLIC_EXECUTION_WS_URL=ws://localhost:8100
PUBLIC_DEV_TOKEN=change-me-dev-token

# --- Securities brokers (docs/BROKERS.md) -----------------------------
# The global LIVE gate (JOSEPH_LIVE_TRADING_ENABLED, above) covers brokers
# too; broker connections stay disabled until enabled below.
# reject (default) or queue: market orders while the exchange is closed.
JOSEPH_EQUITY_CLOSED_MARKET_ORDERS=reject
JOSEPH_PAPER_TWD_STARTING_CASH=3000000
# TWD accounts: money limits and hard caps are the USD values times this.
JOSEPH_TWD_LIMIT_FACTOR=30
# Image build: include broker SDKs.
EXECUTION_UV_EXTRAS=--extra ibkr --extra sinopac
# Secret files live here (never commit them): ibkr_password,
# sinopac_api_key, sinopac_secret_key, sinopac_ca_password,
# sinopac_person_id, Sinopac.pfx.
JOSEPH_SECRETS_DIR=./secrets

# Interactive Brokers (run with --profile ibkr).
IBKR_USERNAME=
IBKR_PASSWORD_FILE=./secrets/ibkr_password
IBKR_TRADING_MODE=paper
IBKR_VNC_PASSWORD_FILE=
JOSEPH_IBKR_ENABLED=false
JOSEPH_IBKR_HOST=ib-gateway
# 4004 = paper, 4003 = live (container relays); keep JOSEPH_IBKR_PAPER in step.
JOSEPH_IBKR_PORT=4004
JOSEPH_IBKR_PAPER=true
JOSEPH_IBKR_SHORT_SELLING=false
JOSEPH_IBKR_READONLY=false

# SinoPac Shioaji (simulation until SinoPac approves production).
JOSEPH_SINOPAC_ENABLED=false
JOSEPH_SINOPAC_SIMULATION=true
JOSEPH_SINOPAC_API_KEY_FILE=
JOSEPH_SINOPAC_SECRET_KEY_FILE=
JOSEPH_SINOPAC_CA_PATH=
JOSEPH_SINOPAC_CA_PASSWORD_FILE=
JOSEPH_SINOPAC_PERSON_ID_FILE=
